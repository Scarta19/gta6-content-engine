# Copy to .env (git-ignored). Load with: set -a; source .env; set +a
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
ZERNIO_API_KEY=
# YouTube Data API v3 key (read-only public metadata for trend intake)
YOUTUBE_API_KEY=
# Second safety switch for real publishing. Must be exactly "yes" together with --live.
GCE_ALLOW_LIVE_PUBLISH=no
